      "use": "@vercel/static"
    },
    {
      "src": "contact-us/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/homepage-banner.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "assets/icon01.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "assets/icon01.svg",
      "use": "@vercel/static"
    },
    {
      "src": "assets/icon02-home.svg",
      "use": "@vercel/static"
    },
    {
      "src": "assets/icon02.svg",
      "use": "@vercel/static"
    },
    {
      "src": "assets/icon03.svg",
